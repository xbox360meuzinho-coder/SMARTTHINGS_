# Credenciais do SmartApp (geradas no SmartThings Developer Workspace)
ST_CLIENT_ID=seu_client_id_aqui
ST_CLIENT_SECRET=seu_client_secret_aqui

# URL pública do seu servidor no Render (sem barra no final)
BASE_URL=https://smartthings-npm.onrender.com

# Chave secreta para assinar sessões/tokens internos (gere uma string aleatória longa)
SESSION_SECRET=troque_por_uma_string_aleatoria_longa_e_unica

# Porta (Render define automaticamente via process.env.PORT, isso é só fallback local)
PORT=3000
